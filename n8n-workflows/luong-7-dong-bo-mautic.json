      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res = $json;\nconst email = $('Chuẩn hoá dữ liệu').first().json.email;\nif (!res.contacts || typeof res.contacts !== 'object') throw new Error('Mautic không trả danh sách contacts hợp lệ');\nconst matches = Object.values(res.contacts).filter(c => {\n  const value = c.fields?.all?.email ?? c.fields?.core?.email?.value ?? c.email;\n  return typeof value === 'string' && value.trim().toLowerCase() === email;\n});\nif (matches.length > 1) throw new Error('Có nhiều contact trùng email, cần kiểm tra trên Mautic');\nconst id = matches.length ? Number(matches[0].id) : null;\nif (matches.length && (!Number.isSafeInteger(id) || id <= 0)) throw new Error('ID contact không hợp lệ');\nreturn [{json:{contactId:id}}];"
      },
