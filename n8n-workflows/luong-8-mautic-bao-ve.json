    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').first().json.body ?? {};\n\nlet contactId = null;\nlet email = '';\nlet points = 0;\nlet eventType = 'UNKNOWN';\nlet pageUrl = '';\nlet description = 'Tương tác trên Mautic';\n\n// 1. Truong hop nhan event Mautic goc (webhook Mautic gui sang)\nif (body['mautic.lead_points_change']) {\n  const item = Array.isArray(body['mautic.lead_points_change']) ? body['mautic.lead_points_change'][0] : body['mautic.lead_points_change'];\n  contactId = item.contact?.id ?? null;\n  email = item.contact?.fields?.all?.email ?? item.contact?.email ?? '';\n  points = Number(item.points?.new_points ?? item.contact?.points ?? 0);\n  eventType = 'POINT_CHANGE';\n  description = `Điểm thay đổi từ ${item.points?.old_points ?? 0} lên ${points}`;\n} else if (body['mautic.page_on_hit'] || body['mautic.page_hit']) {\n  const rawPageHit = body['mautic.page_on_hit'] || body['mautic.page_hit'];\n  const item = Array.isArray(rawPageHit) ? rawPageHit[0] : rawPageHit;\n  contactId = item.contact?.id ?? null;\n  email = item.contact?.fields?.all?.email ?? item.contact?.email ?? '';\n  points = Number(item.contact?.points ?? 0);\n  pageUrl = item.hit?.url ?? '';\n  eventType = 'PAGE_HIT';\n  description = `Khách xem trang: ${item.hit?.urlTitle || pageUrl}`;\n} else if (body['mautic.email_on_open']) {\n  const item = Array.isArray(body['mautic.email_on_open']) ? body['mautic.email_on_open'][0] : body['mautic.email_on_open'];\n  contactId = item.contact?.id ?? null;\n  email = item.contact?.fields?.all?.email ?? item.contact?.email ?? '';\n  points = Number(item.contact?.points ?? 0);\n  eventType = 'EMAIL_OPEN';\n  description = `Khách mở email: ${item.email?.name || 'Chiến dịch'}`;\n} else if (body.contactId || body.email) {\n  // 2. Truong hop goi test hoac custom payload\n  contactId = body.contactId ? Number(body.contactId) : null;\n  email = (body.email || '').trim().toLowerCase();\n  points = Number(body.points ?? body.mauticPoints ?? 0);\n  eventType = body.eventType || body.event || 'TEST_EVENT';\n  pageUrl = body.url || body.pageUrl || '';\n  description = body.description || body.note || 'Cập nhật hành vi khách hàng';\n}\n\n// Trich xuat propertyId neu xem can nha (vd /nha/3 hoac /nha/12)\nlet propertyId = null;\nif (pageUrl) {\n  const match = pageUrl.match(/\\/nha\\/(\\d+)/);\n  if (match) propertyId = Number(match[1]);\n}\n\nreturn [{\n  json: {\n    contactId: contactId ? Number(contactId) : null,\n    email: email.trim().toLowerCase(),\n    points,\n    eventType,\n    pageUrl,\n    propertyId,\n    description\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
