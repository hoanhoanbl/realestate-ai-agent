        "query": "SELECT slug, title, category, content\nFROM kb_documents\nORDER BY slug",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        976,
        160
      ],
      "name": "Đọc tài liệu",
      "executeOnce": true,
      "alwaysOutputData": true,
      "id": "3beed529-8ff6-46ea-a124-5601165b181f",
      "credentials": {
        "postgres": {
          "id": "postgres_account_id",
          "name": "Postgres account"
        }
