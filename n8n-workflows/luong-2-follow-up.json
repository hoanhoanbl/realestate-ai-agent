    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'REMINDER' AS type, l.id AS lead_id, l.name, l.email, l.phone, l.needs, l.level,\n       v.property_id, v.viewing_time\nFROM leads l JOIN viewings v ON v.lead_id = l.id\nWHERE l.status = 'CONFIRMED'\n  AND v.viewing_time BETWEEN now() AND now() + interval '24 hours'\n  AND NOT EXISTS (SELECT 1 FROM lead_events e WHERE e.lead_id = l.id AND e.type = 'REMINDER_SENT')\n  AND NOT EXISTS (SELECT 1 FROM lead_events f WHERE f.lead_id = l.id AND f.type = 'FOLLOWUP_FAILED' AND f.created_at > now() - interval '6 hours')\nUNION ALL\nSELECT 'FEEDBACK', l.id, l.name, l.email, l.phone, l.needs, l.level,\n       v.property_id, v.viewing_time\nFROM leads l JOIN viewings v ON v.lead_id = l.id\nWHERE l.status IN ('CONFIRMED', 'VIEWED')\n  AND v.viewing_time < now() - interval '1 day'\n  AND NOT EXISTS (SELECT 1 FROM lead_events e WHERE e.lead_id = l.id AND e.type = 'FEEDBACK_ASKED')\n  AND NOT EXISTS (SELECT 1 FROM lead_events f WHERE f.lead_id = l.id AND f.type = 'FOLLOWUP_FAILED' AND f.created_at > now() - interval '6 hours')\nUNION ALL\n-- khách WARM đã xem nhà, được hỏi cảm nhận hơn 3 ngày mà vẫn chưa tiến triển: nhắc khách\nSELECT 'WARM_NUDGE', l.id, l.name, l.email, l.phone, l.needs, l.level,\n       v.property_id, v.viewing_time\nFROM leads l JOIN viewings v ON v.lead_id = l.id\nWHERE l.level = 'WARM' AND l.status = 'VIEWED'\n  AND EXISTS (SELECT 1 FROM lead_events e WHERE e.lead_id = l.id AND e.type = 'FEEDBACK_ASKED' AND e.created_at < now() - interval '3 days')\n  AND NOT EXISTS (SELECT 1 FROM lead_events e WHERE e.lead_id = l.id AND e.type = 'WARM_NUDGE_SENT')\n  AND NOT EXISTS (SELECT 1 FROM lead_events f WHERE f.lead_id = l.id AND f.type = 'FOLLOWUP_FAILED' AND f.created_at > now() - interval '6 hours')\nUNION ALL\n-- khách HOT/WARM đăng ký hơn 3 ngày mà nhân viên vẫn chưa duyệt lịch: chỉ nhắc NHÂN VIÊN, không gửi gì cho khách\nSELECT 'STAFF_NUDGE', l.id, l.name, l.email, l.phone, l.needs, l.level,\n       v.property_id, v.viewing_time\nFROM leads l JOIN viewings v ON v.lead_id = l.id\nWHERE l.status = 'NEW' AND l.level IN ('HOT', 'WARM')\n  AND l.created_at < now() - interval '3 days'\n  AND NOT EXISTS (SELECT 1 FROM lead_events e WHERE e.lead_id = l.id AND e.type = 'STAFF_NUDGE_SENT')\n  AND NOT EXISTS (SELECT 1 FROM lead_events f WHERE f.lead_id = l.id AND f.type = 'FOLLOWUP_FAILED' AND f.created_at > now() - interval '6 hours')\nLIMIT 50;"
      },
