      "parameters": {
        "jsonSchemaExample": "{\n  \"sentiment\": \"POSITIVE\",\n  \"summary\": \"Khách hài lòng về vị trí, lo ngại về giá.\",\n  \"nextAction\": \"Gọi trong hôm nay để trao đổi về đặt cọc.\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
