      "parameters": {
        "jsCode": "const c = $('Chuẩn bị ngữ cảnh').item.json;\nlet usedFallback = false;\ntry { usedFallback = !!$('Kiểm tra nội dung AI').item.json.usedFallback; } catch (e) { /* nhánh nhắc nhân viên không qua AI */ }\nreturn { json: { ...c, usedFallback } };"
