    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Đọc hồ sơ Backend').first().json;\nconst leadId = Number(body.leadId);\nif (!Number.isInteger(leadId) || leadId <= 0) {\n  throw new Error('leadId không hợp lệ: ' + body.leadId);\n}\nconst name = String(body.name || '').trim();\nconst parts = name.split(/\\s+/);\nconst firstname = parts.length > 1 ? parts[parts.length - 1] : name;\nconst lastname = parts.length > 1 ? parts.slice(0, -1).join(' ') : '';\nconst email = String(body.email || '').trim().toLowerCase();\nif (email && !/^[^\\s@\"\\\\]+@[^\\s@\"\\\\]+\\.[^\\s@\"\\\\]+$/.test(email)) throw new Error('Email lead không hợp lệ');\nconst rawPhone = String(body.phoneNormalized || body.phone || '').trim();\nif (!/^[+\\d\\s.()-]+$/.test(rawPhone)) throw new Error('Số điện thoại không hợp lệ');\nconst phone = rawPhone.replace(/[\\s.()-]/g,'').replace(/^\\+84/,'0');\nif (!/^\\d{8,15}$/.test(phone)) throw new Error('Số điện thoại không hợp lệ');\nconst mauticContactId = body.mauticContactId == null ? null : Number(body.mauticContactId);\nif (mauticContactId !== null && (!Number.isSafeInteger(mauticContactId) || mauticContactId<=0)) throw new Error('Contact ID đã liên kết không hợp lệ');\nconst level = String(body.level || '').toUpperCase();\nif (level && !['HOT','WARM','COLD'].includes(level)) throw new Error('Mức AI không hợp lệ');\nconst status = String(body.status || 'NEW').toUpperCase();\nif (!['CONSULTING','NEW','CONFIRMED','VIEWED','DEPOSIT','SIGNED','LOST'].includes(status)) throw new Error('Trạng thái lead không hợp lệ');\nconst source = String(body.source || 'direct').trim().toLowerCase();\nconst score = Number(body.score) || 0;\nconst trigger = body.trigger || 'unknown';\n\nconst allStatuses = ['CONSULTING','NEW','CONFIRMED','VIEWED','DEPOSIT','SIGNED','LOST'];\nconst removeStatusTags = allStatuses.filter(s => s !== status).map(s => `-${s}`);\nconst removeLevels = ['HOT','WARM','COLD'].filter(x => x !== level).map(x => `-${x}`);\nconst tags = [level, status, source, ...removeStatusTags, ...removeLevels].filter(Boolean);\nif (level !== 'HOT' && score < 80) tags.push('-vip-prospect');\n\n// Khi lead chuyen sang chot coc (DEPOSIT), da ky (SIGNED) hoac mat khach (LOST), go tag nuoi WARM khoi Mautic\nif (['DEPOSIT', 'SIGNED', 'LOST'].includes(status)) {\n  tags.push('-nuoi-warm');\n}\n\nreturn [{ json: { leadId, name, firstname, lastname, email, phone, mauticContactId, level, status, source, score, trigger, tags } }];"
      },
