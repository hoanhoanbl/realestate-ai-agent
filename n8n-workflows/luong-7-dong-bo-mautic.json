    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let contactId = null;\nif ($('Cập nhật Contact').isExecuted) {\n  const res = $('Cập nhật Contact').first().json;\n  contactId = res.contact?.id ?? res.id ?? null;\n} else if ($('Tạo Contact mới').isExecuted) {\n  const res = $('Tạo Contact mới').first().json;\n  contactId = res.contact?.id ?? res.id ?? null;\n}\n\nif (!contactId) {\n  contactId = $('Tìm Contact Mautic').first().json.contacts ? Object.keys($('Tìm Contact Mautic').first().json.contacts)[0] : null;\n}\n\nreturn [{ json: { contactId: contactId ? Number(contactId) : null, leadId: $node[\"Chuẩn hoá dữ liệu\"].json.leadId, score: $node[\"Chuẩn hoá dữ liệu\"].json.score, level: $node[\"Chuẩn hoá dữ liệu\"].json.level, tags: $node[\"Chuẩn hoá dữ liệu\"].json.tags } }];"
