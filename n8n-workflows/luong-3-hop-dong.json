        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:640px;margin:auto;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden\"><div style=\"background:#2563eb;color:#ffffff;padding:20px;font-size:20px;font-weight:bold\">Hợp đồng đặt cọc cần duyệt</div><div style=\"padding:24px;color:#111827;line-height:1.7;font-size:15px\"><p style=\"margin-top:0\">Nhân viên <b>{{ $('Gộp rà soát').first().json.createdByHtml }}</b> vừa tạo hợp đồng đặt cọc cần anh/chị duyệt trước khi gửi khách ký.</p><table style=\"width:100%;border-collapse:collapse;background:#f3f4f6\"><tr><td style=\"padding:10px;color:#6b7280;width:32%\">Hợp đồng</td><td style=\"padding:10px\"><b>#{{ $('Gộp rà soát').first().json.contractId }}</b></td></tr><tr><td style=\"padding:10px;color:#6b7280;width:32%\">Khách hàng</td><td style=\"padding:10px\">{{ $('Gộp rà soát').first().json.nameHtml }}</td></tr><tr><td style=\"padding:10px;color:#6b7280;width:32%\">Căn nhà</td><td style=\"padding:10px\">{{ $('Gộp rà soát').first().json.propertyNameHtml }}</td></tr><tr><td style=\"padding:10px;color:#6b7280;width:32%\">Giá niêm yết</td><td style=\"padding:10px\">{{ $('Gộp rà soát').first().json.priceText }}</td></tr><tr><td style=\"padding:10px;color:#6b7280;width:32%\">Tiền đặt cọc</td><td style=\"padding:10px\"><b>{{ $('Gộp rà soát').first().json.depositText }} ({{ $('Gộp rà soát').first().json.pct }}%)</b></td></tr></table><p style=\"margin-top:16px\"><b>AI và quy tắc rà soát:</b> mức <b>{{ $('Gộp rà soát').first().json.riskLevel }}</b></p><ul>{{ $('Gộp rà soát').first().json.notesHtml }}</ul><p style=\"margin-top:16px\"><a href=\"{{ $execution.resumeUrl }}{{ $execution.resumeUrl.includes('?') ? '&' : '?' }}action=approve\" style=\"background:#16a34a;color:#ffffff;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block;margin:4px 6px 4px 0\">Duyệt và gửi khách ký</a><a href=\"{{ $execution.resumeUrl }}{{ $execution.resumeUrl.includes('?') ? '&' : '?' }}action=reject&reason=Quản lý từ chối qua email\" style=\"background:#dc2626;color:#ffffff;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block;margin:4px 6px 4px 0\">Từ chối</a><a href=\"{{ $('Cấu hình').first().json.webUrl }}/admin/hop-dong/{{ $('Gộp rà soát').first().json.contractId }}\" style=\"background:#2563eb;color:#ffffff;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block;margin:4px 6px 4px 0\">Xem toàn văn trên web</a></p><p style=\"color:#6b7280;font-size:13px\">Cần duyệt trong 48 giờ, quá hạn hợp đồng sẽ tự hủy.</p></div><div style=\"background:#f9fafb;padding:12px 24px;color:#9ca3af;font-size:12px\">Email tự động từ hệ thống RealEstate AI.</div></div>",
