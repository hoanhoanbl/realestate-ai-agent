    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"subject\": \"Nhắc lịch xem căn hộ\",\n  \"body\": \"Chào anh/chị...\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
