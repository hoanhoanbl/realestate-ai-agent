        "responseBody": "={\n  \"ok\": true,\n  \"leadId\": {{ $('Chuẩn hoá dữ liệu').first().json.leadId }},\n  \"mauticContactId\": {{ $('Gom ID Contact').first().json.contactId || null }},\n  \"tags\": {{ JSON.stringify($('Chuẩn hoá dữ liệu').first().json.tags) }}\n}",
        "options": {}
