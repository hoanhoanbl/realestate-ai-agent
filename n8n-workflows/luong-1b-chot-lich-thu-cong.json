    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = $input.first().json;\nconst k = $('Chuẩn hoá').first().json;\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst timeText = DateTime.fromISO(new Date(q.viewing_time).toISOString()).setZone('Asia/Ho_Chi_Minh').toFormat(\"HH:mm 'ngày' dd/MM/yyyy\");\nreturn [{ json: { leadId: k.leadId, event: k.event, by: k.by, email: q.email, nameHtml: esc(q.name), phoneHtml: esc(q.phone),\n  propertyNameHtml: esc(q.property_name), addressHtml: esc(q.property_address), timeText,\n  // lịch chỉ còn hiệu lực khi khách NEW/CONFIRMED và buổi xem chưa kết thúc / chưa huỷ\n  leadStatus: q.status, viewingStatus: q.viewing_status,\n  manageUrl: q.manage_token ? $('Cấu hình').first().json.publicWebUrl + '/lich/' + q.manage_token : '' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
