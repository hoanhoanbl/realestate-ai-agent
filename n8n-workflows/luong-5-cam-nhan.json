    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = $input.first().json;\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst interestText = { DEPOSIT: 'Muốn đặt cọc căn này', OTHER: 'Muốn xem thêm căn khác', NONE: 'Không còn nhu cầu' }[q.interest] ?? String(q.interest);\nreturn [{ json: {\n  feedbackId: q.feedback_id, leadId: q.lead_id, level: q.level,\n  name: String(q.name), email: q.email, rating: q.rating, interest: q.interest, interestText,\n  comment: String(q.comment ?? ''), propertyName: String(q.property_name ?? '(không rõ)'),\n  nameHtml: esc(q.name), phoneHtml: esc(q.phone), commentHtml: esc(q.comment), propertyNameHtml: esc(q.property_name),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "id": "258370eb-2b6c-4001-8a3d-ce8a5f416e24",
      "name": "Chuẩn bị"
