    {
      "parameters": {
        "jsCode": "const lead = $('Loop Over Items').item.json;\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst p = $json; // kết quả GET /api/properties/:id\nconst purposes = {\n  REMINDER: 'Nhắc khách lịch xem nhà sẽ diễn ra trong 24 giờ tới. Nêu rõ giờ, tên căn, địa chỉ. Dặn khách báo lại nếu cần đổi giờ.',\n  FEEDBACK: 'Khách đã đi xem nhà hôm trước. Cảm ơn, hỏi cảm nhận về căn nhà, gợi ý bước tiếp theo: xem thêm căn khác hoặc trao đổi về đặt cọc. Cuối email có nút \"Gửi cảm nhận\", hãy mời khách bấm nút đó và KHÔNG tự chèn đường link.',\n  WARM_NUDGE: 'Khách WARM đã xem nhà cách đây vài ngày nhưng chưa phản hồi. Viết ĐÚNG 2 câu mở đầu ngắn gọn (dưới 250 ký tự), KHÔNG viết lời chào mở đầu (không \"Chào anh/chị\"), KHÔNG viết lời chào kết thúc, chỉ hỏi thăm nhẹ nhàng về căn nhà đã xem và hỏi thêm nhu cầu (khu vực, giá, số phòng).',\n  STAFF_NUDGE: '',\n};\nconst eventTypes = { REMINDER: 'REMINDER_SENT', FEEDBACK: 'FEEDBACK_ASKED', WARM_NUDGE: 'WARM_NURTURE_STARTED', STAFF_NUDGE: 'STAFF_NUDGE_SENT' };\nreturn {\n  json: {\n    ...lead,\n    nameHtml: esc(lead.name),\n    needsHtml: esc(lead.needs),\n    phoneHtml: esc(lead.phone),\n    propertyName: p.name,\n    propertyAddress: p.address,\n    viewingTimeText: DateTime.fromISO(new Date(lead.viewing_time).toISOString()).setZone('Asia/Ho_Chi_Minh').toFormat(\"HH:mm 'ngày' dd/MM/yyyy\"),\n    purpose: purposes[lead.type],\n    eventType: eventTypes[lead.type],\n  },\n};"
      },
