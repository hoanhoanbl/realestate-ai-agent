    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Chuẩn bị').first().json;\nconst out = $input.first().json.output ?? {};\nconst esc = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nlet sentiment = ['POSITIVE', 'NEUTRAL', 'NEGATIVE'].includes(out.sentiment) ? out.sentiment : null;\nlet summary = String(out.summary ?? '').trim().slice(0, 500);\nlet nextAction = String(out.nextAction ?? '').trim().slice(0, 500);\nlet usedFallback = false;\nif (!sentiment || !summary || !nextAction) { // AI lỗi hoặc trả thiếu: dùng mẫu dự phòng từ số sao và lựa chọn của khách\n  usedFallback = true;\n  sentiment = ctx.rating >= 4 ? 'POSITIVE' : ctx.rating <= 2 ? 'NEGATIVE' : 'NEUTRAL';\n  summary = `Khách đánh giá ${ctx.rating}/5 sao. Lựa chọn: ${ctx.interestText.toLowerCase()}.`;\n  nextAction = ctx.interest === 'DEPOSIT' ? 'Gọi khách sớm để trao đổi đặt cọc.' : ctx.interest === 'OTHER' ? 'Gọi khách gợi ý các căn phù hợp hơn.' : 'Cảm ơn khách và lưu lại để chăm sóc sau.';\n}\n// guardrail: số sao và cảm xúc không được mâu thuẫn\nif (ctx.rating >= 4 && sentiment === 'NEGATIVE') sentiment = 'NEUTRAL';\nif (ctx.rating <= 2 && sentiment === 'POSITIVE') sentiment = 'NEUTRAL';\nreturn [{ json: { ...ctx, sentiment, summary, nextAction, summaryHtml: esc(summary), nextActionHtml: esc(nextAction), usedFallback,\n  needManager: sentiment === 'NEGATIVE' || ctx.rating <= 2 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        200
