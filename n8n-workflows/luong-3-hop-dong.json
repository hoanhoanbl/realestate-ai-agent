    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS contract_id, c.status, c.deposit_amount, c.property_price, c.created_by,\n       l.id AS lead_id, l.name, l.email, l.phone,\n       p.name AS property_name, p.address AS property_address, p.area AS property_area\nFROM contracts c\nJOIN leads l ON l.id = c.lead_id\nJOIN properties p ON p.id = c.property_id\nWHERE c.id = $1::int;",
        "options": {
          "queryReplacement": "={{ $json.contractId }}"
        }
      },
