    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').first().json.body ?? {};\nconst events = [];\nconst score = value => {\n  if (value == null || value === '' || typeof value === 'boolean') return null;\n  const n = Number(value);\n  return Number.isSafeInteger(n) && n >= 0 ? n : null;\n};\nconst add = (item,eventType) => {\n  if (!item || typeof item !== 'object') return;\n  const contact = item.contact ?? item.lead ?? {};\n  const id = Number(contact.id ?? item.contactId);\n  const email = String(contact.fields?.all?.email ?? contact.fields?.core?.email?.value ?? contact.email ?? item.email ?? '').trim().toLowerCase();\n  const points = score(eventType === 'POINT_CHANGE' ? (item.points?.new_points ?? contact.points) : (contact.points ?? item.mauticPoints ?? (typeof item.points !== 'object' ? item.points : null)));\n  const pageUrl = String(item.hit?.url ?? item.url ?? item.pageUrl ?? '');\n  let propertyId = null;\n  if (eventType === 'PAGE_HIT') {\n    // Không phụ thuộc global URL trong sandbox Code của n8n.\n    const url = pageUrl.match(/^(https?):\\/\\/([^/?#]+)(\\/[^?#]*)?(?:[?#].*)?$/i);\n    const web = String($('Cấu hình').first().json.publicWebUrl || '').match(/^(https?):\\/\\/([^/?#]+)(?:[/?#]|$)/i);\n    const match = url && (url[3] || '/').match(/^\\/nha\\/(\\d+)\\/?$/);\n    if (url && web && match && url[1].toLowerCase() === web[1].toLowerCase() && url[2].toLowerCase() === web[2].toLowerCase()) propertyId = Number(match[1]);\n  }\n  const description = eventType === 'POINT_CHANGE' ? `Điểm thay đổi lên ${points ?? 'không xác định'}`\n    : eventType === 'PAGE_HIT' ? `Khách xem trang: ${item.hit?.urlTitle || pageUrl}`\n    : eventType === 'EMAIL_OPEN' ? `Khách mở email: ${item.email?.name || 'Chiến dịch'}`\n    : String(item.description ?? item.note ?? 'Tương tác trên Mautic');\n  events.push({json:{contactId:Number.isSafeInteger(id) && id>0 ? id:null,email,points,eventType,pageUrl,propertyId,description}});\n};\nfor (const [key,type] of [['mautic.lead_points_change','POINT_CHANGE'],['mautic.page_on_hit','PAGE_HIT'],['mautic.page_hit','PAGE_HIT'],['mautic.email_on_open','EMAIL_OPEN']]) {\n  if (body[key]) for (const item of (Array.isArray(body[key]) ? body[key] : [body[key]])) add(item,type);\n}\nif (!events.length && (body.contactId || body.email)) add(body,String(body.eventType || body.event || 'TEST_EVENT'));\nreturn events.length ? events : [{json:{contactId:null,email:'',points:null,eventType:'UNKNOWN',propertyId:null,description:'Không có sự kiện được hỗ trợ'}}];"
      },
