    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Soạn hợp đồng').first().json;\nconst out = $input.first().json.output ?? {};\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst order = ['LOW', 'MEDIUM', 'HIGH'];\nconst aiOk = order.includes(out.riskLevel) && Array.isArray(out.notes);\nconst aiNotes = aiOk ? out.notes.map(n => String(n).trim().slice(0, 200)).filter(Boolean).slice(0, 3) : [];\nconst ruleLevel = c.pct > 30 ? 'HIGH' : c.flags.length ? 'MEDIUM' : 'LOW';\n// lấy mức cao hơn giữa quy tắc cố định và AI: AI không thể hạ mức rủi ro mà quy tắc đã phát hiện\nconst riskLevel = order[Math.max(order.indexOf(ruleLevel), aiOk ? order.indexOf(out.riskLevel) : 0)];\nconst notes = [...c.flags, ...aiNotes].slice(0, 6);\nif (notes.length === 0) notes.push('Không phát hiện vấn đề (AI không khả dụng, chỉ kiểm tra bằng quy tắc).');\nreturn [{ json: { ...c, riskLevel, notes, notesHtml: notes.map(n => '<li>' + esc(n) + '</li>').join(''), aiUsed: aiOk,\n  aiReview: JSON.stringify({ riskLevel, notes, aiUsed: aiOk }) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ],
