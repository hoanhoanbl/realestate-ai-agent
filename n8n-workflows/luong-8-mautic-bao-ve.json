    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const lead = $('Tìm Lead Backend').first().json;\nconst data = $('Chuẩn hoá dữ liệu').first().json;\nconst cfg = $('Cấu hình').first().json;\n\nconst title = data.propertyId\n  ? `Khách xem lại căn #${data.propertyId}`\n  : `Khách đạt ${data.points} điểm tương tác Mautic`;\n\nconst message = `Khách hàng ${lead.name} (${lead.phone || lead.email}) vừa có tương tác mới trên Mautic:\\n`\n  + `- Hành vi: ${data.description}\\n`\n  + `- Điểm Mautic hiện tại: ${data.points}\\n`\n  + `- Phân khúc ban đầu: ${lead.level || 'Chưa phân loại'}`;\n\nconst actions = [\n  { label: 'Xem chi tiết khách', url: `${cfg.publicWebUrl}/admin/leads/${lead.id}` }\n];\n\nif (data.propertyId) {\n  actions.push({ label: 'Xem căn nhà', url: `${cfg.publicWebUrl}/nha/${data.propertyId}` });\n}\n\nreturn [{\n  json: {\n    leadId: lead.id,\n    level: lead.level || 'HOT',\n    title,\n    message,\n    actions\n  }\n}];"
      },
