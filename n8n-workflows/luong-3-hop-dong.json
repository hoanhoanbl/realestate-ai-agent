    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"riskLevel\": \"LOW\",\n  \"notes\": [\"Nội dung đầy đủ, số liệu khớp.\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1360,
