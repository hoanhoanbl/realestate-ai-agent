      ],
      "id": "70010001-0000-4000-8000-000000000002",
      "name": "Cấu hình"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').first().json.body ?? {};\nconst leadId = Number(body.leadId);\nif (!Number.isInteger(leadId) || leadId <= 0) {\n  throw new Error('leadId không hợp lệ: ' + body.leadId);\n}\nconst name = (body.name || '').trim();\nconst parts = name.split(' ');\nconst firstname = parts.length > 1 ? parts[parts.length - 1] : name;\nconst lastname = parts.length > 1 ? parts.slice(0, -1).join(' ') : '';\nconst email = (body.email || '').trim().toLowerCase();\nconst phone = (body.phone || '').trim();\nconst level = (body.level || 'NEW').toUpperCase();\nconst status = (body.status || 'NEW').toUpperCase();\nconst source = (body.source || 'direct').toLowerCase();\nconst score = Number(body.score) || 0;\nconst trigger = body.trigger || 'unknown';\nconst tags = [level, status, source].filter(Boolean);\n\nreturn [{\n  json: {\n    leadId,\n    name,\n    firstname,\n    lastname,\n    email,\n    phone,\n    level,\n    status,\n    source,\n    score,\n    trigger,\n    tags\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ],
      "id": "70010001-0000-4000-8000-000000000003",
      "name": "Chuẩn hoá dữ liệu"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Cấu hình').first().json.mauticUrl }}/contacts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "search",
              "value": "=email:{{ $json.email }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        240
      ],
      "id": "70010001-0000-4000-8000-000000000004",
      "name": "Tìm Contact Mautic",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "c-exists",
              "leftValue": "={{ Number($json.total || 0) }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        240
      ],
      "id": "70010001-0000-4000-8000-000000000005",
      "name": "Contact đã có?"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Cấu hình').first().json.mauticUrl }}/contacts/{{ Object.keys($('Tìm Contact Mautic').first().json.contacts)[0] }}/edit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $('Chuẩn hoá dữ liệu').first().json.phone }}\",\n  \"points\": {{ $('Chuẩn hoá dữ liệu').first().json.score }},\n  \"tags\": {{ JSON.stringify($('Chuẩn hoá dữ liệu').first().json.tags) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        140
      ],
      "id": "70010001-0000-4000-8000-000000000006",
      "name": "Cập nhật Contact",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Cấu hình').first().json.mauticUrl }}/contacts/new",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"firstname\": \"{{ $('Chuẩn hoá dữ liệu').first().json.firstname }}\",\n  \"lastname\": \"{{ $('Chuẩn hoá dữ liệu').first().json.lastname }}\",\n  \"email\": \"{{ $('Chuẩn hoá dữ liệu').first().json.email }}\",\n  \"phone\": \"{{ $('Chuẩn hoá dữ liệu').first().json.phone }}\",\n  \"points\": {{ $('Chuẩn hoá dữ liệu').first().json.score }},\n  \"tags\": {{ JSON.stringify($('Chuẩn hoá dữ liệu').first().json.tags) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        340
      ],
      "id": "70010001-0000-4000-8000-000000000007",
      "name": "Tạo Contact mới",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let contactId = null;\nif ($('Cập nhật Contact').isExecuted) {\n  const res = $('Cập nhật Contact').first().json;\n  contactId = res.contact?.id ?? res.id ?? null;\n} else if ($('Tạo Contact mới').isExecuted) {\n  const res = $('Tạo Contact mới').first().json;\n  contactId = res.contact?.id ?? res.id ?? null;\n}\n\nif (!contactId) {\n  contactId = $('Tìm Contact Mautic').first().json.contacts ? Object.keys($('Tìm Contact Mautic').first().json.contacts)[0] : null;\n}\n\nreturn [{\n  json: {\n    contactId: contactId ? Number(contactId) : null,\n    leadId: $('Chuẩn hoá dữ liệu').first().json.leadId,\n    score: $('Chuẩn hoá dữ liệu').first().json.score,\n    level: $('Chuẩn hoá dữ liệu').first().json.level,\n    tags: $('Chuẩn hoá dữ liệu').first().json.tags\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        240
      ],
      "id": "70010001-0000-4000-8000-000000000008",
      "name": "Gom ID Contact"
    },
