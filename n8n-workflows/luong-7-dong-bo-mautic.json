          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"MAUTIC_SYNCED\",\n  \"note\": \"Đã đồng bộ Contact #\" + ($('Gom ID Contact').first().json.contactId || 'unknown') + \" (tags: \" + $('Chuẩn hoá dữ liệu').first().json.tags.join(', ') + \")\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
