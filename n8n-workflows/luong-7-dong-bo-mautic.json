    {
      "id": "mautic-Chọn Contact đúng định danh",
      "name": "Chọn Contact đúng định danh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const res = $json;\nconst p = $('Chuẩn hoá dữ liệu').first().json;\nconst field=(c,key)=>c.fields?.all?.[key] ?? c.fields?.core?.[key]?.value ?? c[key] ?? '';\nconst phone=value=>String(value??'').replace(/[\\s.()-]/g,'').replace(/^\\+84/,'0');\nif(!res.contacts || typeof res.contacts!=='object')throw new Error('Mautic không trả danh sách contacts hợp lệ');\nif(Number(res.total??0)>100)throw new Error('Quá nhiều contact ứng viên, cần kiểm tra định danh trước khi đồng bộ');\nconst candidates=Object.values(res.contacts);\nconst matches=candidates.filter(c=>phone(field(c,'phone'))===p.phone || (p.email && String(field(c,'email')).trim().toLowerCase()===p.email));\nconst ids=new Set(matches.map(c=>Number(c.id)));\nif(ids.size>1)throw new Error('Có nhiều contact trùng số điện thoại/email, cần kiểm tra trên Mautic');\nlet selected=matches[0]??null;\nif(p.mauticContactId){\n const linked=$('Đọc Contact đã liên kết').first().json.contact;\n if(!linked || Number(linked.id)!==p.mauticContactId)throw new Error('Contact ID đã liên kết không còn hợp lệ');\n if(selected && Number(selected.id)!==p.mauticContactId)throw new Error('Contact đã liên kết xung đột với số điện thoại/email');\n selected=linked;\n}\nif(selected){\n const raw=String(field(selected,'phone')).trim();\n if(raw && phone(raw)!==p.phone)throw new Error('Email trùng nhưng số điện thoại thuộc khách khác');\n if(!raw && (!p.email || String(field(selected,'email')).trim().toLowerCase()!==p.email))throw new Error('Không xác minh được định danh contact đã liên kết');\n}\nconst contactId=selected?Number(selected.id):null;\nif(selected && (!Number.isSafeInteger(contactId)||contactId<=0))throw new Error('ID contact không hợp lệ');\nconst existingEmail=selected?String(field(selected,'email')).trim().toLowerCase():'';\nconst payload={firstname:p.firstname,lastname:p.lastname,phone:p.phone,tags:p.tags,overwriteWithBlank:false};\n// Không gửi email rỗng hoặc thay email Mautic đã có bằng địa chỉ khác.\nif(p.email && (!existingEmail || existingEmail===p.email))payload.email=p.email;\nreturn [{json:{contactId,payload,emailPreserved:!!existingEmail && existingEmail!==p.email}}];"
      },
      "onError": "continueErrorOutput"
    },
