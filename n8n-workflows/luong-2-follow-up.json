    {
      "parameters": {
        "jsCode": "const ctx = $('Chuẩn bị ngữ cảnh').item.json;\nconst out = $json.output ?? {};\nlet subject = String(out.subject ?? '').trim();\nlet body = String(out.body ?? '').trim();\n\nconst isWarm = ctx.type === 'WARM_NUDGE';\nconst ok = subject.length > 0 && body.length > 0 && body.length <= (isWarm ? 300 : 1200)\n  && (isWarm || body.includes(ctx.name)) && !body.includes('{{');\n\nif (!ok) {\n  const fallback = {\n    REMINDER: ['Nhắc lịch xem nhà', `Chào anh/chị ${ctx.name}, chúng tôi xin nhắc lịch xem ${ctx.propertyName} lúc ${ctx.viewingTimeText} tại ${ctx.propertyAddress}. Nếu cần đổi giờ, anh/chị vui lòng trả lời email này.`],\n    FEEDBACK: ['Cảm ơn anh/chị đã đi xem nhà', `Chào anh/chị ${ctx.name}, cảm ơn anh/chị đã xem ${ctx.propertyName}. Anh/chị thấy căn nhà thế nào? Chúng tôi sẵn sàng giới thiệu thêm căn khác hoặc trao đổi về đặt cọc.`],\n    WARM_NUDGE: ['Gợi ý thêm căn nhà phù hợp', 'Chúng tôi muốn hỏi thăm cảm nhận của anh/chị về buổi xem nhà hôm trước và tìm hiểu thêm nhu cầu cụ thể để gợi ý các căn phù hợp hơn.'],\n  }[ctx.type];\n  [subject, body] = fallback;\n}\n\nif (isWarm) {\n  body = body.replace(/^(Chào\\s+[^,\\.\\n]+[,\\.\\n]\\s*)+/i, '').trim();\n  if (body.length > 250) body = body.slice(0, 247) + '...';\n}\n\nconst esc = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst bodyHtml = esc(body).replace(/\\n+/g, '<br>');\nreturn { json: { ...ctx, subject, body, bodyHtml, usedFallback: !ok } };"
      },
