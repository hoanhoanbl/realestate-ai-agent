    {
      "parameters": {
        "jsCode": "// Gom nhà và tài liệu thành từng item { text, source, ref, title, category } để nạp vào pgvector.\nconst TYPE_VI = { APARTMENT: 'Căn hộ', TOWNHOUSE: 'Nhà phố', VILLA: 'Biệt thự', SHOPHOUSE: 'Shophouse', LAND: 'Đất nền' };\nconst ty = (v) => (Number(v) / 1e9).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + ' tỷ';\n\nconst out = [];\nfor (const { json: p } of $('Đọc căn nhà').all()) {\n  if (!p.id) continue;\n  out.push({ json: {\n    text: [\n      `Căn nhà #${p.id}: ${p.name}`,\n      `Loại: ${TYPE_VI[p.type] || p.type}`,\n      `Địa chỉ: ${p.address}`,\n      `Giá: ${ty(p.price)}`,\n      `Diện tích: ${p.area} m2`,\n      `Trạng thái: ${p.status === 'RESERVED' ? 'đã có người đặt cọc, không nhận lịch xem' : 'đang bán'}`,\n      `Mô tả: ${p.description || '(chưa có mô tả)'}`,\n    ].join('\\n'),\n    source: 'property',\n    ref: String(p.id),\n    title: p.name,\n    category: 'nha',\n  } });\n}\nfor (const { json: d } of $('Đọc tài liệu').all()) {\n  if (!d.slug) continue;\n  out.push({ json: { text: `${d.title}\\n${d.content}`, source: 'kb', ref: d.slug, title: d.title, category: d.category } });\n}\nif (out.length === 0) throw new Error('Không có nhà hay tài liệu nào để nạp');\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        160
      ],
      "name": "Gom tài liệu",
      "id": "659776c3-cbf4-42f7-bda5-2aedc6d51c3f"
