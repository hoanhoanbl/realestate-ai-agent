# Sao chep file nay thanh .env roi dien gia tri that. KHONG commit file .env.

# --- Database ---
DB_NAME=realestate
DB_USER=realestate
DB_PASSWORD=123456

# --- n8n ---
# Tao chuoi ngau nhien dai, giu nguyen sau khi da tao workflow/credential
N8N_ENCRYPTION_KEY=doi_chuoi_ngau_nhien_dai
# Chu y: N8N_WEBHOOK_URL o day la URL goc cua n8n (dung cho container n8n):
# Local: http://localhost:5678/   |   Khi deploy: https://n8n.ten-mien-cua-ban.com/
# (Con trong backend/.env thi N8N_WEBHOOK_URL phai la URL day du cua webhook, vi du: http://localhost:5678/webhook/viewing-requested)
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Bao mat webhook giua backend va n8n (gui qua header X-Webhook-Secret) ---
WEBHOOK_SECRET=hoanghauQueen

# --- JWT va seed user ---
JWT_SECRET=doi_chuoi_ngau_nhien_dai
SEED_USER_PASSWORD=hoanghauQueen

# Dia chi cong khai cua web, dung de tao link ky hop dong /ky/<token> trong email
PUBLIC_WEB_URL=http://localhost:3000

# --- Mautic 5 (Hau so huu - docker-compose.mautic.yml) ---
MAUTIC_PORT=8082
MAUTIC_DB_NAME=mautic
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=mautic_123456
MAUTIC_MYSQL_ROOT_PASSWORD=mautic_root_123456
# Tai khoan Mautic ma luong 7 dung goi API (Basic auth, bat trong Mautic > Configuration > API Settings)
MAUTIC_API_USER=
MAUTIC_API_PASSWORD=
# URL API Mautic cho luong 7. De trong khi chay local (dung http://mautic_web:80/api). Tren server: https://mautic.<domain>/api
MAUTIC_URL=
# ID form Standalone dang ky ban tin (FE-21). De trong: an link dang ky tren web.
# Khong phai ID segment/campaign. Truyen qua docker-compose.newsletter.yml luc build web.
NEXT_PUBLIC_MAUTIC_NEWSLETTER_FORM_ID=
# Token cho webhook Mautic -> luong 8 (Mautic goi .../webhook/mautic-event?token=<token>). Chuoi ngau nhien >= 24 ky tu,
# vi du: openssl rand -hex 24. Khong dung mat khau Mautic. Trong thi luong 8 tu choi moi su kien (403).
MAUTIC_WEBHOOK_SECRET=

# URL webhook lead-changed cua n8n (L7 dong bo sang Mautic). De trong neu chua cai Mautic.
N8N_LEAD_CHANGED_URL=http://n8n:5678/webhook/lead-changed

# --- Gioi han form dat lich (POST /api/viewings) theo IP khach ---
# So lan toi da trong mot khoang thoi gian (ms). n8n gui kem X-Webhook-Secret thi khong bi gioi han.
BOOKING_RATE_LIMIT=5
BOOKING_RATE_TTL_MS=600000
# So proxy dung truoc backend de lay dung IP khach (local khong qua proxy van de 1 duoc; server: javis-proxy)
TRUST_PROXY_HOPS=1

# Mat khau user readonly cho n8n doc DB (dung trong readonly-role.sql)
# N8N_READONLY_DB_PASSWORD=doi_mat_khau

# --- Chi dung cho docker-compose.prod.yml (deploy VM) ---
# Ten mien cong khai (khong co https://). Chua co ten mien thi dung <IP-co-dau-gach>.sslip.io, vi du 1-2-3-4.sslip.io
PUBLIC_HOST=1-2-3-4.sslip.io

# --- Telegram: bot bao nhan vien sale (sub-workflow thong-bao-nhan-vien) ---
# Tao bot bang @BotFather lay token; chat_id lay tu getUpdates sau khi nhan tin cho bot.
# De trong thi sub-workflow chi gui email.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SALE_CHAT_ID=

# --- Telegram: bot tu van cho khach (luong 6), bot rieng voi bot sale ---
# Secret: chuoi ngau nhien (A-Z a-z 0-9 _ -), dang ky cung luc setWebhook (secret_token)
TELEGRAM_KHACH_BOT_TOKEN=
TELEGRAM_KHACH_WEBHOOK_SECRET=

# --- Cac khoa ben ngoai: nhap trong n8n (Credentials), khong de trong repo ---
# Gemini API key, Gmail/SMTP
