        "jsCode": "// Gom dữ liệu báo nhân viên (gửi sang sub-workflow \"thong-bao-nhan-vien\")\nconst k = $('Chuẩn hoá').first().json;\nconst ai = $('Basic LLM Chain').first().json.output;\nconst p = $('Ghép dữ liệu').first().json.property;\nconst source = String($('Webhook').first().json.body?.source ?? '').toLowerCase();\nconst webUrl = String($env.PUBLIC_WEB_URL || 'http://localhost:3000').replace(/\\/$/, '');\n\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst money = (n) => {\n  n = Number(n) || 0;\n  if (n >= 1e9) return (Math.round(n / 1e7) / 100).toLocaleString('vi-VN') + ' tỷ';\n  if (n >= 1e6) return Math.round(n / 1e6).toLocaleString('vi-VN') + ' triệu';\n  return n.toLocaleString('vi-VN') + ' đ';\n};\nconst SOURCES = { facebook: 'Facebook', zalo: 'Zalo', google: 'Google', tiktok: 'TikTok', referral: 'Giới thiệu', direct: 'Trực tiếp' };\nconst sourceText = SOURCES[source] ?? (source || 'Trực tiếp');\nconst t = DateTime.fromISO(k.viewingTime).setZone('Asia/Ho_Chi_Minh');\nconst thu = ['', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy', 'Chủ nhật'][t.weekday];\nconst timeText = t.toFormat('HH:mm') + ' · ' + thu + ' ' + t.toFormat('dd/MM/yyyy');\n\n// FE-35: nút Duyệt / Đổi giờ là link do backend cấp (dùng được tới giờ hẹn), không còn gắn với lần chạy này.\n// Backend lỗi thì chỉ còn nút \"Xem chi tiết\"; nhân viên duyệt trên trang quản trị.\nconst linkRes = $('Lấy link duyệt').isExecuted ? $('Lấy link duyệt').first().json : {};\nconst approveUrl = /^https?:\\/\\//.test(String(linkRes.approveUrl ?? '')) ? linkRes.approveUrl : '';\nconst rescheduleUrl = /^https?:\\/\\//.test(String(linkRes.rescheduleUrl ?? '')) ? linkRes.rescheduleUrl : '';\nconst assigneeId = Number($('Webhook').first().json.body?.assignedUserId) || 0;\nconst detailUrl = webUrl + '/admin/leads/' + k.leadId;\n\nconst color = { HOT: '#dc2626', WARM: '#f59e0b', COLD: '#6b7280' }[ai.level] ?? '#2563eb';\nconst row = (label, value) => '<tr><td style=\"padding:10px;color:#6b7280;width:35%\">' + label + '</td><td style=\"padding:10px\">' + value + '</td></tr>';\nconst btn = (url, label, bg) => '<a href=\"' + esc(url) + '\" style=\"background:' + bg + ';color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;display:inline-block;margin:0 6px 6px 0\">' + label + '</a>';\nconst emailHtml = '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden\">'\n  + '<div style=\"background:' + color + ';color:#ffffff;padding:20px;font-size:20px;font-weight:bold\">Khách ' + esc(ai.level) + ' - cần duyệt lịch xem nhà</div>'\n  + '<div style=\"padding:24px;color:#111827;line-height:1.7;font-size:15px\">'\n  + '<p style=\"margin-top:0\"><b>Điểm AI: ' + esc(ai.score) + '/100</b> &mdash; ' + esc(ai.reason) + '</p>'\n  + '<table style=\"width:100%;border-collapse:collapse;background:#f3f4f6\">'\n  + row('Khách hàng', '<b>' + esc(k.name) + '</b>')\n  + row('Số điện thoại', esc(k.phone))\n  + row('Email', esc(k.email))\n  + row('Ngân sách', esc(Number(k.budget).toLocaleString('vi-VN')) + ' VND')\n  + row('Nguồn khách', esc(sourceText))\n  + row('Nhu cầu', esc(k.needs || '(không ghi)'))\n  + row('Căn nhà', esc(p.name) + ', ' + esc(p.address))\n  + row('Giờ xem nhà', '<b>' + esc(timeText) + '</b>')\n  + '</table>'\n  + '<p style=\"margin-top:20px;padding:12px;background:#fffbeb;border-left:4px solid #f59e0b\"><b>Gợi ý của AI:</b> ' + esc(ai.staffNote) + '</p>'\n  + '<p style=\"margin-top:20px\">' + (approveUrl ? btn(approveUrl, 'Duyệt lịch', '#16a34a') : '') + (rescheduleUrl ? btn(rescheduleUrl, 'Đổi giờ', '#6b7280') : '') + btn(detailUrl, 'Xem chi tiết', '#2563eb') + '</p>'\n  + '</div>'\n  + '<div style=\"background:#f9fafb;padding:12px 24px;color:#9ca3af;font-size:12px\">Nút Duyệt và Đổi giờ dùng được tới giờ hẹn. Quá 2 giờ làm việc chưa xử lý, hệ thống sẽ báo cho quản lý.</div>'\n  + '</div>';\n\nreturn [{\n  json: {\n    leadId: k.leadId,\n    level: ai.level,\n    title: k.name + ' - ' + ai.score + ' điểm - cần duyệt lịch xem',\n    fields: [\n      { icon: '👤', label: 'Khách', value: k.name },\n      { icon: '📞', label: 'SĐT', value: k.phone },\n      { icon: '✉️', label: 'Email', value: k.email },\n      { icon: '💰', label: 'Ngân sách', value: money(k.budget) },\n      { icon: '📣', label: 'Nguồn', value: sourceText },\n      { sep: true },\n      { icon: '🏠', label: 'Căn', value: p.name },\n      { icon: '📍', label: 'Địa chỉ', value: p.address },\n      { icon: '🕙', label: 'Giờ xem', value: timeText },\n      { sep: true },\n      { icon: '🎯', label: 'Điểm AI', value: ai.score + '/100 (' + ai.level + ')' },\n      { icon: '🧠', label: 'Lý do', value: ai.reason },\n      { icon: '📝', label: 'Nhu cầu', value: k.needs },\n    ],\n    note: 'Gợi ý của AI: ' + ai.staffNote,\n    actions: [\n      ...(approveUrl ? [{ label: '✅ Duyệt lịch', url: approveUrl }] : []),\n      ...(rescheduleUrl ? [{ label: '🕓 Đổi giờ', url: rescheduleUrl }] : []),\n      { label: '📋 Xem chi tiết', url: detailUrl },\n    ],\n    detailUrl,\n    assigneeId, // sub-workflow gửi riêng cho sale này; 0 = chưa có người phụ trách, báo quản lý\n    emailHtml,\n  },\n}];"
      },
