    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst failed = rows.filter(r => r.type === 'ERROR').length;\nconst ok = rows.filter(r => r.type !== 'ERROR');\nconst count = t => ok.filter(r => r.type === t).length;\nreturn [{\n  json: {\n    total: ok.length,\n    failed,\n    reminder: count('REMINDER'),\n    feedback: count('FEEDBACK'),\n    warmNudge: count('WARM_NUDGE'),\n    staffNudge: count('STAFF_NUDGE'),\n    fallback: ok.filter(r => r.usedFallback).length,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
