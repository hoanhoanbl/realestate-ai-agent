        "jsCode": "const k = $('Chuẩn hoá').first().json;\nconst p = $input.first().json; // ket qua GET /api/properties/:id (price, area la chuoi)\nconst price = Number(p.price);\nreturn [{\n  json: {\n    ...k,\n    property: { name: p.name, address: p.address, price, area: Number(p.area), type: p.type },\n    budgetRatio: price > 0 ? Math.round((k.budget / price) * 100) : null, // % ngan sach so voi gia\n  },\n}];"
      },
