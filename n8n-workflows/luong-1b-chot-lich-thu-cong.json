    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('Webhook').first().json.body ?? {};\nconst leadId = Number(b.leadId);\nif (!Number.isInteger(leadId) || leadId <= 0) throw new Error('leadId không hợp lệ: ' + b.leadId);\nif (!['approved', 'rescheduled'].includes(b.event)) throw new Error('event không hợp lệ: ' + b.event);\nreturn [{ json: { leadId, event: b.event, by: String(b.by ?? 'nhân viên').slice(0, 100) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "id": "a68872f5-1770-4f50-be8f-326eecc1baad",
      "name": "Chuẩn hoá"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id AS lead_id, l.name, l.email, l.phone, l.status, v.viewing_time,\n       v.status AS viewing_status, v.manage_token,\n       p.name AS property_name, p.address AS property_address\nFROM leads l\nJOIN viewings v ON v.lead_id = l.id\nJOIN properties p ON p.id = v.property_id\nWHERE l.id = $1::int\nORDER BY v.id DESC LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.leadId }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        200
      ],
      "id": "effb0c01-1cd6-4b35-b3c1-97b0268e3937",
      "name": "Lấy dữ liệu lịch",
