    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = $input.first().json;\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst money = n => Number(n).toLocaleString('vi-VN') + ' đồng';\nconst price = Number(q.property_price);\nconst deposit = Number(q.deposit_amount);\nconst rawPct = (deposit / price) * 100;\nconst pct = rawPct < 1 ? Math.round(rawPct * 100) / 100 : Math.round(rawPct * 10) / 10;\nconst now = DateTime.now().setZone('Asia/Ho_Chi_Minh');\nconst content = [\n  'CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM',\n  'Độc lập - Tự do - Hạnh phúc',\n  '',\n  'HỢP ĐỒNG ĐẶT CỌC MUA BÁN BẤT ĐỘNG SẢN',\n  `Số: HD-${String(q.contract_id).padStart(4, '0')}`,\n  `Ngày lập: ${now.toFormat('dd/MM/yyyy')}`,\n  '',\n  'BÊN NHẬN ĐẶT CỌC (Bên A): Văn phòng môi giới RealEstate AI.',\n  `BÊN ĐẶT CỌC (Bên B): ${q.name}, điện thoại ${q.phone}, email ${q.email}.`,\n  '',\n  'Điều 1. Đối tượng',\n  `Bên B đặt cọc để giữ chỗ mua: ${q.property_name}, địa chỉ ${q.property_address}, diện tích ${Number(q.property_area)} m2.`,\n  '',\n  'Điều 2. Giá và tiền đặt cọc',\n  `Giá niêm yết: ${money(price)}.`,\n  `Tiền đặt cọc: ${money(deposit)} (${pct}% giá niêm yết).`,\n  '',\n  'Điều 3. Thời hạn giữ chỗ',\n  `Bên A giữ căn nhà cho Bên B đến hết ngày ${now.plus({ days: 30 }).toFormat('dd/MM/yyyy')}. Trong thời gian này Bên A không bán hoặc nhận đặt cọc của người khác.`,\n  '',\n  'Điều 4. Quyền và nghĩa vụ khi kết thúc thời hạn giữ chỗ',\n  '- Bên B đồng ý mua: tiền đặt cọc được trừ vào giá mua khi hai bên ký hợp đồng mua bán.',\n  '- Bên B từ chối mua trong thời hạn: Bên B mất tiền đặt cọc.',\n  '- Bên A từ chối bán hoặc bán cho người khác: Bên A hoàn lại tiền đặt cọc và bồi thường thêm một khoản bằng tiền đặt cọc.',\n  '',\n  'Điều 5. Cam kết',\n  'Hai bên cam kết thông tin trong hợp đồng là đúng sự thật và tự nguyện ký kết.',\n  '',\n  'Hợp đồng được ký điện tử qua hệ thống RealEstate AI. Bản này là mẫu phục vụ đồ án môn học, không có giá trị pháp lý.',\n].join('\\n');\n// Kiểm tra bằng quy tắc cố định (không phụ thuộc AI)\nconst flags = [];\nif (pct > 30) flags.push(`Tiền cọc ${pct}% giá niêm yết, cao bất thường (thường 5 đến 10%).`);\nif (pct < 1) flags.push(`Tiền cọc chỉ ${pct}% giá niêm yết, khó ràng buộc khách.`);\nif (String(q.phone).replace(/\\D/g, '').length < 9) flags.push('Số điện thoại của khách có vẻ chưa đầy đủ.');\nreturn [{ json: {\n  contractId: q.contract_id, leadId: q.lead_id, title: `Hợp đồng đặt cọc ${q.property_name}`.slice(0, 200),\n  content, contentHtml: esc(content), flags, pct, price, deposit,\n  priceText: money(price), depositText: money(deposit),\n  name: q.name, email: q.email, createdBy: q.created_by,\n  nameHtml: esc(q.name), propertyNameHtml: esc(q.property_name), createdByHtml: esc(q.created_by),\n} }];"
      },
