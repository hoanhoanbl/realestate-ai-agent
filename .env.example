# Sao chep file nay thanh .env roi dien gia tri that. KHONG commit file .env.

# --- Database ---
DB_NAME=realestate
DB_USER=realestate
DB_PASSWORD=123456

# --- n8n ---
# Tao chuoi ngau nhien dai, giu nguyen sau khi da tao workflow/credential
N8N_ENCRYPTION_KEY=doi_chuoi_ngau_nhien_dai
# Chu y: N8N_WEBHOOK_URL o day la URL goc cua n8n (dung cho container n8n):
# Local: http://localhost:5678/   |   Khi deploy: https://n8n.ten-mien-cua-ban.com/
# (Con trong backend/.env thi N8N_WEBHOOK_URL phai la URL day du cua webhook, vi du: http://localhost:5678/webhook/viewing-requested)
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Bao mat webhook giua backend va n8n (gui qua header X-Webhook-Secret) ---
WEBHOOK_SECRET=hoanghauQueen

# --- JWT va seed user ---
JWT_SECRET=doi_chuoi_ngau_nhien_dai
SEED_USER_PASSWORD=hoanghauQueen

# Dia chi cong khai cua web, dung de tao link ky hop dong /ky/<token> trong email
PUBLIC_WEB_URL=http://localhost:3000

# --- Mautic (Hau so huu) ---
# URL webhook lead-changed cua n8n (L7 dong bo sang Mautic). De trong neu chua cai Mautic.
# N8N_LEAD_CHANGED_URL=http://n8n:5678/webhook/lead-changed
# Mat khau user readonly cho n8n doc DB (dung trong readonly-role.sql)
# N8N_READONLY_DB_PASSWORD=doi_mat_khau

# --- Cac khoa ben ngoai: nhap trong n8n (Credentials), khong de trong repo ---
# Gemini API key, Gmail/SMTP (khong dung Telegram)
