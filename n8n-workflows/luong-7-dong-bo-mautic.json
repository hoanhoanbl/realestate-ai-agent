    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').first().json.body ?? {};\nconst leadId = Number(body.leadId);\nif (!Number.isInteger(leadId) || leadId <= 0) {\n  throw new Error('leadId không hợp lệ: ' + body.leadId);\n}\nconst name = (body.name || '').trim();\nconst parts = name.split(' ');\nconst firstname = parts.length > 1 ? parts[parts.length - 1] : name;\nconst lastname = parts.length > 1 ? parts.slice(0, -1).join(' ') : '';\nconst email = (body.email || '').trim().toLowerCase();\nconst phone = (body.phone || '').trim();\nconst level = (body.level || 'NEW').toUpperCase();\nconst status = (body.status || 'NEW').toUpperCase();\nconst source = (body.source || 'direct').toLowerCase();\nconst score = Number(body.score) || 0;\nconst trigger = body.trigger || 'unknown';\n\nconst allStatuses = ['NEW','CONFIRMED','VIEWED','DEPOSIT','SIGNED','LOST'];\nconst removeStatusTags = allStatuses.filter(s => s !== status).map(s => `-${s}`);\nconst tags = [level, status, source, ...removeStatusTags].filter(Boolean);\n\n// Khi lead chuyen sang chot coc (DEPOSIT), da ky (SIGNED) hoac mat khach (LOST), go tag nuoi WARM khoi Mautic\nif (['DEPOSIT', 'SIGNED', 'LOST'].includes(status)) {\n  tags.push('-nuoi-warm');\n}\n\nreturn [{ json: { leadId, name, firstname, lastname, email, phone, level, status, source, score, trigger, tags } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ],
      "id": "70010001-0000-4000-8000-000000000003",
      "name": "Chuẩn hoá dữ liệu"
